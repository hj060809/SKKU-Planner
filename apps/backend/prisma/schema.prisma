generator client {
  provider = "prisma-client-js"
}

generator graphql {
  provider           = "prisma-nestjs-graphql"
  output             = "../apps/@generated"
  purgeOutput        = true
  noAtomicOperations = true
  // emitCompiled       = true
  emitSingle         = true
  reExport           = Single
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
